# Copy to .env and fill in real values. .env is git-ignored.
LANGUAGE_MODEL_NAME=deepseek-chat
LANGUAGE_MODEL_PROVIDER=deepseek
API_TOKEN=your-api-key

# Optional: seconds per request to the model (default: 30) and retries of a failed request (default: 2).
# LANGUAGE_MODEL_TIMEOUT=30
# LANGUAGE_MODEL_MAX_RETRIES=2

# Name the agent uses when it speaks on your behalf.
OWNER_NAME=Alex

# Optional: directory with prompt YAML files (default: ./prompts).
# PROMPTS_DIR=prompts
